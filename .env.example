NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Used for platform admin operations and registration pre-checks,
# never by MK Pati AI (the AI path reads data with the signed-in user's RLS client).
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SALT=replace-with-a-long-random-secret

# OpenAI (server-only). MK Pati AI is NOT_CONFIGURED until both are set.
OPENAI_API_KEY=
OPENAI_MODEL=
# In-app voice: speech-to-text model (optional, default gpt-4o-mini-transcribe).
OPENAI_TRANSCRIPTION_MODEL=
