NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SALT=replace-with-a-long-random-secret

# OpenAI (server-only). AI is NOT_CONFIGURED until both are set.
OPENAI_API_KEY=
OPENAI_MODEL=

# WhatsApp Business Platform / Meta Cloud API (server-only).
# Required: access token, phone number id, verify token, app secret.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0
# Test mode is ON unless explicitly "false": only WHATSAPP_TEST_RECIPIENT can receive messages.
WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_RECIPIENT=
# Approved template for first contact outside the 24h customer service window (optional).
WHATSAPP_OUTREACH_TEMPLATE_NAME=
WHATSAPP_OUTREACH_TEMPLATE_LANGUAGE=tr

# Voice is not part of this sprint.
VOICE_PROVIDER=
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_WEBHOOK_SECRET=
